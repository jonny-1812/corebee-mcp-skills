{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__corebee__reply_to_conversation",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/validate-reply.sh"
          }
        ]
      },
      {
        "matcher": "mcp__corebee__delete_*|mcp__corebee__close_*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/warn-destructive.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__corebee__close_conversation",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/remind-resolution-note.sh"
          }
        ]
      },
      {
        "matcher": "mcp__corebee__assign_conversation",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/confirm-assignment.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/log-agent-start.sh"
          }
        ]
      }
    ]
  }
}
